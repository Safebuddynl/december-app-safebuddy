# Copy this file to `.env.local` and fill in the values.
# Ask a team member for the shared project credentials.
#
# Only variables prefixed with VITE_ reach the browser, and Vite inlines them
# into the built JavaScript. Never put a secret here: anything in this file is
# readable by anyone who loads the site.

# Supabase project URL, e.g. https://<project-id>.supabase.co
VITE_SUPABASE_URL=

# The Supabase anonymous ("publishable") key. Safe to ship, because row-level
# security decides what it may read. Never use the service_role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Mapbox public token (starts with "pk."). Used for map tiles, address search
# and route planning. Without it the map falls back to OpenStreetMap tiles and
# route planning is unavailable.
VITE_MAPBOX_TOKEN=
